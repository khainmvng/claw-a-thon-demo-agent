GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=
GREENNODE_AGENT_IDENTITY=

# Whisper model size: tiny | base | small | medium | large
# Larger = more accurate but slower and needs more RAM
WHISPER_MODEL=base

# HuggingFace token for speaker diarization (pyannote/speaker-diarization-3.1)
# Get one at https://huggingface.co/settings/tokens
# Also accept the model license at https://huggingface.co/pyannote/speaker-diarization-3.1
# Leave empty to disable speaker detection (transcription still works)
HUGGINGFACE_TOKEN=
